{
  "name": "@iicp/client",
  "version": "0.7.93",
  "description": "Use the open IICP AI mesh from TypeScript or JavaScript without running a node",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "iicp-node": "dist/cli.js"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "require": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "iicp",
    "ai-agents",
    "protocol",
    "sdk"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobLe3/iicp-client-typescript.git"
  },
  "homepage": "https://iicp.network",
  "bugs": {
    "url": "https://github.com/RobLe3/iicp-client-typescript/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cbor-x": "^1.6.4",
    "json-canonicalize": "2.0.0"
  },
  "peerDependencies": {
    "nat-upnp": ">=1.1",
    "prom-client": ">=14"
  },
  "peerDependenciesMeta": {
    "prom-client": {
      "optional": true
    },
    "nat-upnp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prom-client": "^15",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "files": [
    "dist",
    "README.md",
    "intent-risk-taxonomy.json",
    "mcp-tool-risk-taxonomy.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
